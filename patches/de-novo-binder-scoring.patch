+def collapse_target_chains_for_group_scoring(struct_path: str, binder_chain: str, target_chains: List[str]) -> str:
+    """
+    Return a scoring-only structure where all declared target fragments share one chain ID.
+
+    The PAE matrix is indexed by residue/token order, not chain labels. Rewriting only the
+    chain labels therefore preserves the matrix alignment while making ipSAE, pDockQ2,
+    pDockQ, LIS, and iPAE score binder-vs-whole-target instead of binder-vs-fragment
+    followed by post-hoc aggregation.
+    """
+    target_group = [chain for chain in target_chains if chain and chain != binder_chain]
+    if len(target_group) <= 1:
+        return struct_path
+
+    source = Path(struct_path)
+    merged_chain = target_group[0]
+    merged = source.with_name(f"{source.stem}_targetgroup_{merged_chain}{source.suffix}")
+    try:
+        text = source.read_text()
+    except Exception:
+        return struct_path
+
+    if source.suffix.lower() == ".pdb":
+        changed = False
+        lines = []
+        residue_numbers: Dict[Tuple[str, str, str, str], int] = {}
+        next_residue = 1
+        for line in text.splitlines(keepends=True):
+            if (line.startswith("ATOM") or line.startswith("HETATM")) and len(line) > 26 and line[21].strip() in target_group:
+                original_chain = line[21].strip()
+                original_resseq = line[22:26].strip()
+                original_icode = line[26:27]
+                residue_name = line[17:20]
+                residue_key = (original_chain, original_resseq, original_icode, residue_name)
+                if residue_key not in residue_numbers:
+                    residue_numbers[residue_key] = next_residue
+                    next_residue += 1
+                new_resseq = residue_numbers[residue_key]
+                line = f"{line[:21]}{merged_chain[:1]}{new_resseq:4d}{line[26:]}"
+                changed = True
+            elif (line.startswith("TER") or line.startswith("ANISOU")) and len(line) > 21 and line[21].strip() in target_group:
+                line = f"{line[:21]}{merged_chain[:1]}{line[22:]}"
+                changed = True
+            lines.append(line)
+        if changed:
+            merged.write_text("".join(lines))
+            return str(merged)
+        return struct_path
+
+    if source.suffix.lower() == ".cif":
+        atomsite_fields: Dict[str, int] = {}
+        field_index = 0
+        residue_numbers: Dict[Tuple[str, str, str], int] = {}
+        next_residue = 1
