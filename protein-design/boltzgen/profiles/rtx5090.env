# RTX 5090 (Blackwell, sm_120, 32 GB), targeting the kit-pinned CUDA 13 /
# Torch 2.13 stack. This profile remains unvalidated on physical 5090 hardware.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-RTX5090}
export MODEL_OPT_JIT_ROOT=${MODEL_OPT_JIT_ROOT:-/cache/boltzgen/jit}
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"
