+                field = stripped.split(".", 1)[1]
+                atomsite_fields[field] = field_index
+                field_index += 1
+                out_lines.append(line)
+                continue
+            if stripped.startswith(("ATOM", "HETATM")) and atomsite_fields:
+                parts = stripped.split()
+                label_asym_idx = atomsite_fields.get("label_asym_id")
+                original_chain = parts[label_asym_idx] if label_asym_idx is not None and label_asym_idx < len(parts) else ""
+                if original_chain in target_group:
+                    label_seq_idx = atomsite_fields.get("label_seq_id")
+                    comp_idx = atomsite_fields.get("label_comp_id")
+                    original_seq = parts[label_seq_idx] if label_seq_idx is not None and label_seq_idx < len(parts) else ""
+                    original_comp = parts[comp_idx] if comp_idx is not None and comp_idx < len(parts) else ""
+                    residue_key = (original_chain, original_seq, original_comp)
+                    if residue_key not in residue_numbers:
+                        residue_numbers[residue_key] = next_residue
+                        next_residue += 1
+                    new_resseq = str(residue_numbers[residue_key])
+                    for seq_field in ("label_seq_id", "auth_seq_id"):
+                        seq_idx = atomsite_fields.get(seq_field)
+                        if seq_idx is not None and seq_idx < len(parts) and parts[seq_idx] != ".":
+                            parts[seq_idx] = new_resseq
+                            changed = True
+                for field_name in ("label_asym_id", "auth_asym_id"):
+                    idx = atomsite_fields.get(field_name)
