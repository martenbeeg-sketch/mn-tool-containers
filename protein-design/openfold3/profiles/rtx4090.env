# Native OpenFold3 0.5.0 + OpenBind-0 profile.
# RTX 4090: sm_89, 24 GiB, NVIDIA driver 595.91.07, CUDA 12.8 image.
# Local validation is recorded in optimized/benchmarks/; the kit reports each
# kernel's sm_89 support or named fallback. big uses the kit's row-sharded
# prediction over the two local RTX 4090 cards.
MODEL_OPT_TARGET_GPU=RTX4090
GPU_ARCH=sm_89
GPU_MEMORY_MIB=24564
GPU_DRIVER=595.91.07
CUDA_STACK=12.8.1
TORCH=2.10.0+cu128
VALIDATION_STATUS=validated
