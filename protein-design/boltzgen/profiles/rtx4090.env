# RTX 4090 (Ada, sm_89, 24 GB), running the kit-pinned CUDA 13 / Torch 2.13
# stack. The kit admits this GPU by compute capability (>= 8.0).
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-RTX4090}
export MODEL_OPT_JIT_ROOT=${MODEL_OPT_JIT_ROOT:-/cache/boltzgen/jit}
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"
