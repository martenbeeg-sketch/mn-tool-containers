# Boltz-2 deployment profile for NVIDIA GeForce RTX 5090 (Blackwell, sm_120).
# Runtime validation is still required on a real RTX 5090.
export MN_BOLTZ2_PROFILE=rtx5090
export MN_BOLTZ2_EXPECTED_SM=120
export MN_BOLTZ2_PROFILE_VALIDATED=0
export MN_BOLTZ2_MODE=off
export MN_BOLTZ2_N_GPU=1
export MN_BOLTZ2_ALLOW_PARTIAL=1
