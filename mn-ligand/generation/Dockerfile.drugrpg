FROM mn-biohub-esm:cu128

ARG SOURCE_COMMIT=6fa0e417a523627728eac26a75e3eaab8f3926dc

LABEL org.opencontainers.image.title="mn-ligand DrugRPG generation engine" \
      org.opencontainers.image.description="DrugRPG custom-pocket CUDA 12.8 runtime for Ada and Blackwell GPUs" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/Hit-zhongyu/DrugRPG"

ENV ENGINE="drugrpg" \
    CUDA_HOME="/usr/local/cuda" \
    TORCH_CUDA_ARCH_LIST="8.9;12.0+PTX" \
    PYTHONPATH="/opt/engine" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONUNBUFFERED="1"

WORKDIR /opt/engine

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libglib2.0-0 libgl1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
      pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv \
      -f https://data.pyg.org/whl/torch-2.7.0+cu128.html \
    && python -m pip install --no-cache-dir \
      biopython easydict lmdb \
      matplotlib networkx openbabel-wheel pandas pyyaml \
      scikit-learn scipy torch-geometric==2.7.0 tqdm

COPY scripts/fetch-pinned-source.sh /usr/local/bin/mn-fetch-source
COPY patches/DrugRPG.patch /opt/mn-tool-patches/DrugRPG.patch
RUN chmod +x /usr/local/bin/mn-fetch-source \
    && mn-fetch-source https://github.com/Hit-zhongyu/DrugRPG.git "${SOURCE_COMMIT}" /opt/engine DrugRPG.patch
COPY --from=app /containers/generation/runner.py /opt/mn-ligand/generation_runner.py

ENTRYPOINT ["python", "/opt/mn-ligand/generation_runner.py"]
CMD ["--help"]
