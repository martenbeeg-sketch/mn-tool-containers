FROM mn-biohub-esm:cu128

ARG SOURCE_COMMIT=33be6c1f3dc9f42deb7a27be974ab9f5fc241497

LABEL org.opencontainers.image.title="mn-ligand PFM generation engine" \
      org.opencontainers.image.description="PFM custom-pocket CUDA 12.8 runtime for Ada and Blackwell GPUs" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/HZ-W/PFM"

ENV ENGINE="pfm" \
    CUDA_HOME="/usr/local/cuda" \
    TORCH_CUDA_ARCH_LIST="8.9;12.0+PTX" \
    PYTHONPATH="/opt/engine" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONUNBUFFERED="1"

WORKDIR /opt/engine

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libglib2.0-0 libgl1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
      pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv \
      -f https://data.pyg.org/whl/torch-2.7.0+cu128.html \
    && python -m pip install --no-cache-dir \
      easydict einops lmdb networkx openbabel-wheel pandas pyyaml \
      scikit-learn scipy torch-geometric==2.7.0 tqdm

COPY scripts/fetch-pinned-source.sh /usr/local/bin/mn-fetch-source
COPY patches/PFM.patch /opt/mn-tool-patches/PFM.patch
RUN chmod +x /usr/local/bin/mn-fetch-source \
    && mn-fetch-source https://github.com/kurisu92725/PFM.git "${SOURCE_COMMIT}" /opt/engine PFM.patch
COPY --from=app /containers/generation/runner.py /opt/mn-ligand/generation_runner.py

ENTRYPOINT ["python", "/opt/mn-ligand/generation_runner.py"]
CMD ["--help"]
