# AF3 deployment profile for NVIDIA GeForce RTX 5090 (Blackwell, sm_120).
# Runtime validation is still required on a real RTX 5090.
export MN_COFOLDING_AF3_PROFILE=rtx5090
export MN_COFOLDING_AF3_EXPECTED_SM=120
export MN_COFOLDING_AF3_PROFILE_VALIDATED=0
export MN_COFOLDING_AF3_OPT_MODE=off
export MN_COFOLDING_AF3_N_GPU=1
export MN_COFOLDING_AF3_OPT_KERNELS=both
