FROM mn-biohub-esm:cu128

ARG SOURCE_COMMIT=4294d286375116942762b0688c4e012fceeec1c9

LABEL org.opencontainers.image.title="mn-ligand conDitar generation engine" \
      org.opencontainers.image.description="Locally permissioned conDitar CUDA 12.8 runtime for Ada and Blackwell GPUs" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/Drug-Bioinformatics-Lab/conDitar-dev"

ENV ENGINE="conditar" \
    CUDA_HOME="/usr/local/cuda" \
    TORCH_CUDA_ARCH_LIST="8.9;12.0+PTX" \
    PYTHONPATH="/opt/engine" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONUNBUFFERED="1"

WORKDIR /opt/engine

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libglib2.0-0 libgl1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
      pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv \
      -f https://data.pyg.org/whl/torch-2.7.0+cu128.html \
    && python -m pip install --no-cache-dir \
      easydict lmdb openbabel-wheel pandas pyyaml scikit-learn scipy \
      tensorboard torch-geometric==2.7.0 tqdm

COPY scripts/fetch-pinned-source.sh /usr/local/bin/mn-fetch-source
COPY patches/conDitar.patch /opt/mn-tool-patches/conDitar.patch
RUN chmod +x /usr/local/bin/mn-fetch-source \
    && mn-fetch-source https://github.com/ninglab/conDitar-dev.git "${SOURCE_COMMIT}" /opt/engine conDitar.patch
COPY --from=app /containers/generation/runner.py /opt/mn-ligand/generation_runner.py

ENTRYPOINT ["python", "/opt/mn-ligand/generation_runner.py"]
CMD ["--help"]
